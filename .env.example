APP_NAME="Production RAG Evaluation Framework"
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_observability
REDIS_URL=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_documents
VECTOR_BACKEND=faiss

DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DEFAULT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DEFAULT_LLM_PROVIDER=mock
GEMINI_MODEL=gemini-2.5-flash-lite

OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
LANGSMITH_API_KEY=
MLFLOW_TRACKING_URI=file:./experiments/mlruns
